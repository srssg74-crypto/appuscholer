rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function exactKeys(data, keys) { return data.keys().hasAll(keys) && data.keys().hasOnly(keys); }
    function validCode(code) { return code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{10}$'); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function redemptionPath(code, uid) { return /databases/$(database)/documents/invites/$(code)/redemptions/$(uid); }
    function inviteValidForBatch(code, uid) {
      return validCode(code)
        && exists(invitePath(code))
        && get(invitePath(code)).data.active == true
        && request.time < get(invitePath(code)).data.redeemBy
        && getAfter(invitePath(code)).data.usedCount == get(invitePath(code)).data.usedCount + 1
        && getAfter(invitePath(code)).data.usedCount <= get(invitePath(code)).data.maxUses
        && existsAfter(redemptionPath(code, uid))
        && getAfter(redemptionPath(code, uid)).data.uid == uid
        && getAfter(redemptionPath(code, uid)).data.redeemedAt == request.time;
    }
    function validUserCreate(uid) {
      let d = request.resource.data;
      let inv = get(invitePath(d.inviteCode)).data;
      return isOwner(uid)
        && request.auth.token.email_verified == true
        && exactKeys(d, ['displayName','email','institution','course','plan','status','inviteCode','accessExpiresAt','consent','createdAt','schemaVersion'])
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 80
        && d.email is string && d.email == request.auth.token.email
        && d.institution is string && d.institution.size() <= 120
        && d.course is string && d.course.size() <= 80
        && d.plan == 'free' && d.status == 'active'
        && d.inviteCode is string && inviteValidForBatch(d.inviteCode, uid)
        && d.accessExpiresAt is timestamp && d.accessExpiresAt > request.time
        && d.accessExpiresAt <= request.time + duration.value(inv.accessDays, 'd')
        && d.consent is map
        && exactKeys(d.consent, ['version','acceptedAt','ageConfirmed18'])
        && d.consent.version is string && d.consent.version.size() >= 1
        && d.consent.acceptedAt == request.time
        && d.consent.ageConfirmed18 == true
        && d.createdAt == request.time && d.schemaVersion == 1;
    }
    function validTombstone(uid) {
      let d = request.resource.data;
      let old = resource.data;
      return isOwner(uid)
        && old.status in ['active','suspended']
        && exactKeys(d, ['status','deletionRequestedAt','schemaVersion'])
        && d.status == 'deleting'
        && d.deletionRequestedAt == request.time
        && d.schemaVersion == 1
        && old.inviteCode is string
        && exists(redemptionPath(old.inviteCode, uid))
        && !existsAfter(redemptionPath(old.inviteCode, uid));
    }
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if validUserCreate(uid);
      allow update: if (isOwner(uid)
          && resource.data.status != 'deleting'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','institution','course','consent'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) || (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 80))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['institution']) || (request.resource.data.institution is string && request.resource.data.institution.size() <= 120))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['course']) || (request.resource.data.course is string && request.resource.data.course.size() <= 80))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent']) || (request.resource.data.consent is map && request.resource.data.consent.version is string && request.resource.data.consent.version != resource.data.consent.version && request.resource.data.consent.acceptedAt == request.time && request.resource.data.consent.ageConfirmed18 == true && exactKeys(request.resource.data.consent,['version','acceptedAt','ageConfirmed18'])))
        ) || (isAdmin() && resource.data.status != 'deleting' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','plan','accessExpiresAt']) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['active','suspended']) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']) || request.resource.data.plan is string) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accessExpiresAt']) || request.resource.data.accessExpiresAt is timestamp));
      allow update: if validTombstone(uid);
      // Admin erases an account whose access ended more than 90 days ago (privacy notice, 2026-10-v1).
      // The profile becomes the same blank marker as a self-deletion, so the uid can never redeem again.
      allow update: if isAdmin()
        && resource.data.status in ['active','suspended']
        && resource.data.accessExpiresAt < request.time - duration.value(90, 'd')
        && exactKeys(request.resource.data, ['status','deletionRequestedAt','schemaVersion'])
        && request.resource.data.status == 'deleting'
        && request.resource.data.deletionRequestedAt == request.time
        && request.resource.data.schemaVersion == 1;
      // Owners never delete their users doc outright; account deletion always leaves the tombstone, so the uid can never redeem again.
      allow delete: if isAdmin();
    }
    match /invites/{code} {
      allow list, delete: if isAdmin();
      // A verified user who has not joined yet may read one invite by its exact code, to learn its access period
      // while redeeming. Members and unverified users cannot; nobody but an admin can list invites.
      allow get: if isAdmin() || (signedIn() && request.auth.token.email_verified == true && !exists(userPath(request.auth.uid)));
      allow create: if isAdmin() && validCode(code)
        && exactKeys(request.resource.data,['label','createdBy','createdAt','redeemBy','accessDays','maxUses','usedCount','active'])
        && request.resource.data.label is string && request.resource.data.label.size() >= 1 && request.resource.data.label.size() <= 120
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.redeemBy is timestamp && request.resource.data.redeemBy > request.time
        && request.resource.data.accessDays is int && request.resource.data.accessDays >= 1 && request.resource.data.accessDays <= 366
        && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1
        && request.resource.data.usedCount == 0 && request.resource.data.active == true;
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label','redeemBy','accessDays','maxUses','active'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['label']) || request.resource.data.label is string)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['redeemBy']) || request.resource.data.redeemBy is timestamp)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accessDays']) || (request.resource.data.accessDays is int && request.resource.data.accessDays >= 1 && request.resource.data.accessDays <= 366))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['maxUses']) || (request.resource.data.maxUses is int && request.resource.data.maxUses >= 1))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['active']) || request.resource.data.active is bool))
        || (signedIn() && resource.data.active == true && request.time < resource.data.redeemBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
          && request.resource.data.usedCount == resource.data.usedCount + 1
          && request.resource.data.usedCount <= resource.data.maxUses
          && existsAfter(userPath(request.auth.uid))
          && getAfter(userPath(request.auth.uid)).data.inviteCode == code
          && getAfter(userPath(request.auth.uid)).data.status == 'active'
          && existsAfter(redemptionPath(code, request.auth.uid))
          && !exists(redemptionPath(code, request.auth.uid)));
      match /redemptions/{uid} {
        allow read: if isAdmin() || isOwner(uid);
        allow create: if isOwner(uid) && request.auth.token.email_verified == true
          && exactKeys(request.resource.data,['uid','redeemedAt'])
          && request.resource.data.uid == uid && request.resource.data.redeemedAt == request.time
          && exists(invitePath(code)) && get(invitePath(code)).data.active == true
          && request.time < get(invitePath(code)).data.redeemBy
          && getAfter(invitePath(code)).data.usedCount == get(invitePath(code)).data.usedCount + 1
          && getAfter(invitePath(code)).data.usedCount <= get(invitePath(code)).data.maxUses
          && existsAfter(userPath(uid)) && getAfter(userPath(uid)).data.inviteCode == code
          && getAfter(userPath(uid)).data.status == 'active';
        allow update: if false;
        allow delete: if isAdmin() || (isOwner(uid) && !exists(userPath(uid))) || (isOwner(uid) && exists(userPath(uid)) && getAfter(userPath(uid)).data.status == 'deleting' && !existsAfter(redemptionPath(code, uid)));
      }
    }
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}